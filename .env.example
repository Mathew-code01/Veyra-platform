# Veyra Platform environment configuration
# Copy this file to .env and fill in values. Never commit .env.
# Values shown are placeholders only - do not use them in production.

# --- Application ---
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
API_VERSION=v1
REQUEST_ID_HEADER=X-Request-Id

# --- CORS / allowed origins ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Logging ---
LOG_LEVEL=info

# --- Supabase (set when ready for Phase 2; mock/local used until then) ---
# Project: veyra-platform (cyoavpeazeatnlnfbbag)
# Get keys from https://app.supabase.com/project/cyoavpeazeatnlnfbbag/settings/api
SUPABASE_URL=https://cyoavpeazeatnlnfbbag.supabase.co
# SUPABASE_ANON_KEY=<anon-public-key>          # safe to expose, but keep in .env only
# SUPABASE_SERVICE_ROLE_KEY=<service-role-secret>   # server-only, never in client bundle/.env.example
# DATABASE_URL=<optional direct postgres connection>
#
# For Supabase CLI authentication (non-TTY environments):
# Generate a personal access token at https://app.supabase.com/account/tokens
# Set locally: $env:SUPABASE_ACCESS_TOKEN="<token>"   (never commit this)

# --- OAuth (Google / GitHub) ---
# Configure these providers in the Supabase Dashboard under Authentication > Providers.
# The callback URL is: https://cyoavpeazeatnlnfbbag.supabase.co/auth/v1/callback
# GOOGLE_CLIENT_ID=<google-oauth-client-id>
# GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>   # server-only
# GITHUB_CLIENT_ID=<github-oauth-client-id>
# GITHUB_CLIENT_SECRET=<github-oauth-client-secret>   # server-only
# OAUTH_REDIRECT_BASE_URL=http://localhost:3000/auth/callback

# --- Paystack (Payment Provider) ---
# PAYMENT_PROVIDER=paystack
# PAYSTACK_SECRET_KEY=<paystack-secret-key>           # server-only, never in client bundle
# PAYSTACK_PUBLIC_KEY=<paystack-public-key>           # safe for frontend
# PAYSTACK_WEBHOOK_SECRET=<paystack-webhook-secret>   # server-only
# PAYMENTS_MODE=test
# PAYMENTS_LIVE_ENABLED=false

# --- Email (dev/test adapter until a provider is configured) ---
# EMAIL_PROVIDER=mock
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# --- Object storage (R2 proposed; not required initially) ---
# STORAGE_PROVIDER=mock
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- Update signing (Phase 9) ---
# UPDATE_SIGNING_KEY=<ed25519 private key for signing release metadata>
